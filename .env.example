# ---------------------------------------------------------------------------
# Ortam degiskenleri ornegi  ->  cp .env.example .env
# Anahtar tanimli degilse sistem otomatik olarak "offline" heuristik beyne
# duser ve tamamen calisir durumda kalir (deterministik, API'siz mod).
# ---------------------------------------------------------------------------

# LLM saglayicisi: auto | openai | anthropic | offline
AGENCY_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
AGENCY_LLM_MODEL=gpt-4o-mini
AGENCY_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Orkestrasyon backend'i: native | crewai | langgraph
AGENCY_BACKEND=native

# Borsa / piyasa
AGENCY_EXCHANGE_ID=binance
AGENCY_SYMBOL=BTC/USDT
AGENCY_TIMEFRAME=1h
AGENCY_DATA_PROVIDER=auto

# Veritabani ve log konumlari
AGENCY_DB_PATH=runtime/agency.db
AGENCY_LOG_DIR=runtime/logs

# Dongu hedefleri
AGENCY_MIN_NET_PROFIT_PCT=3.0
AGENCY_MIN_WIN_RATE=45.0
AGENCY_MAX_DRAWDOWN_PCT=25.0
AGENCY_CYCLE_SLEEP_SECONDS=60
